<Window x:Class="WpfLab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная работа 2 — WPF / MVVM"
        Width="1380" Height="900" MinWidth="1080" MinHeight="700"
        Background="{DynamicResource MainBrush}"
        FontFamily="{Binding SelectedFontFamily}"
        FontSize="{Binding FontSize}">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{DynamicResource CardBrush}">
            <MenuItem Header="_Файл">
                <MenuItem Header="Добавить запись в таблицу 1" Command="{Binding AddSourceRowCommand}"/>
                <MenuItem Header="Удалить выбранную запись" Command="{Binding DeleteSourceRowCommand}"/>
                <Separator/>
                <MenuItem Header="Выход" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Вид">
                <MenuItem Header="Светлая тема" Command="{Binding SetLightThemeCommand}"/>
                <MenuItem Header="Тёмная тема" Command="{Binding SetDarkThemeCommand}"/>
            </MenuItem>
            <MenuItem Header="_Таблицы">
                <MenuItem Header="Добавить строку в таблицу 1" Command="{Binding AddSourceRowCommand}"/>
                <MenuItem Header="Добавить строку в таблицу 2" Command="{Binding AddDestinationRowCommand}"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource CardBrush}">
            <StatusBarItem><TextBlock Text="{Binding StatusMessage}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="WPF / .NET 8 / MVVM"/></StatusBarItem>
        </StatusBar>

        <TabControl Margin="10">
            <!-- Исходная вкладка ЛР1: настройки и цветовая палитра -->
            <TabItem Header="1.1 Основное">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Основные настройки приложения" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

                        <GroupBox Header="1.1.1 Структурированные настройки персонализации">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="1.1.1.1 Тема приложения:" VerticalAlignment="Center" Margin="4"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableThemes}"
                                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"/>

                                <TextBlock Grid.Column="2" Text="1.1.1.2 Язык приложения:" VerticalAlignment="Center" Margin="4"/>
                                <StackPanel Grid.Column="3">
                                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"/>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,4">
                                        <TextBlock Text="Выбран язык: " Opacity="0.7" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedLanguage}" Opacity="0.7" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="1.1.2.1 Шрифт:" VerticalAlignment="Center" Margin="4"/>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <ComboBox ItemsSource="{Binding AvailableFonts}"
                                              SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}"/>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,4">
                                        <TextBlock Text="Выбран шрифт: " Opacity="0.7" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedFontFamily}" Opacity="0.7" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="1.1.2.2 Размер шрифта:" VerticalAlignment="Center" Margin="4"/>
                                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider Minimum="11" Maximum="20" Value="{Binding FontSize, Mode=TwoWay}"
                                            Width="250" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding FontSize, StringFormat={}{0:F0}}" Width="35" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                    <TextBlock Text="pt" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="4,12,4,0" TextWrapping="Wrap"
                                           Text="Параметры темы, языка, шрифта и размера связаны с моделью представления через Binding. Выбор темы переключает словарь ресурсов, а шрифт и размер применяются к окну."/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="1.2 Цветовая палитра из библиотеки ресурсов">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Текущая тема:" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedTheme}" FontSize="20" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,12"/>
                                    <TextBlock Text="Основной цвет" Margin="0,4"/>
                                    <Border Height="32" Background="{DynamicResource MainBrush}" BorderBrush="{DynamicResource BorderBrushLab}" BorderThickness="1" CornerRadius="5"/>
                                    <TextBlock Text="Акцентный цвет" Margin="0,10,0,4"/>
                                    <Border Height="32" Background="{DynamicResource AccentBrush}" CornerRadius="5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="25,0,0,0">
                                    <TextBlock Text="Цвета состояний" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <UniformGrid Columns="3">
                                        <Border Margin="4" Padding="10" Background="{DynamicResource SuccessBrush}" CornerRadius="6">
                                            <StackPanel><TextBlock Text="Успех" Foreground="White" FontWeight="Bold"/><TextBlock Text="#16A34A" Foreground="White"/></StackPanel>
                                        </Border>
                                        <Border Margin="4" Padding="10" Background="{DynamicResource ErrorBrush}" CornerRadius="6">
                                            <StackPanel><TextBlock Text="Ошибка" Foreground="White" FontWeight="Bold"/><TextBlock Text="#DC2626" Foreground="White"/></StackPanel>
                                        </Border>
                                        <Border Margin="4" Padding="10" Background="{DynamicResource InfoBrush}" CornerRadius="6">
                                            <StackPanel><TextBlock Text="Информация" Foreground="White" FontWeight="Bold"/><TextBlock Text="#0891B2" Foreground="White"/></StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="1.2.3 Таблица оттенков (цвет / код / наименование)">
                            <UniformGrid Columns="5">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Основной" FontWeight="Bold"/>
                                    <Border Height="28" Background="{DynamicResource MainBrush}" BorderBrush="{DynamicResource BorderBrushLab}" BorderThickness="1" Margin="0,5"/>
                                    <TextBlock Text="#F4F7FB — фон (светлая тема)"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Акцентный" FontWeight="Bold"/>
                                    <Border Height="28" Background="{DynamicResource AccentBrush}" Margin="0,5"/>
                                    <TextBlock Text="#2563EB — синий (светлая тема)"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Успех" FontWeight="Bold"/>
                                    <Border Height="28" Background="{DynamicResource SuccessBrush}" Margin="0,5"/>
                                    <TextBlock Text="#16A34A — зелёный (светлая тема)"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Ошибка" FontWeight="Bold"/>
                                    <Border Height="28" Background="{DynamicResource ErrorBrush}" Margin="0,5"/>
                                    <TextBlock Text="#DC2626 — красный (светлая тема)"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Информация" FontWeight="Bold"/>
                                    <Border Height="28" Background="{DynamicResource InfoBrush}" Margin="0,5"/>
                                    <TextBlock Text="#0891B2 — бирюзовый (светлая тема)"/>
                                </StackPanel>
                            </UniformGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Элементы управления ЛР1 -->
            <TabItem Header="1.3 Элементы управления">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Демонстрация элементов управления и их состояний" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Expander Header="1.3.1 Кнопки: обычные, пиктограммы, переключатели" IsExpanded="True">
                            <StackPanel Margin="8">
                                <TextBlock Text="Обычные кнопки" FontWeight="Bold"/>
                                <WrapPanel>
                                    <Button Content="Обычная"/>
                                    <Button Content="Успех" Background="{DynamicResource SuccessBrush}"/>
                                    <Button Content="Ошибка" Background="{DynamicResource ErrorBrush}"/>
                                    <Button Content="Информация" Background="{DynamicResource InfoBrush}"/>
                                    <Button Content="Отключена" IsEnabled="False"/>
                                </WrapPanel>
                                <TextBlock Text="Кнопки-пиктограммы" FontWeight="Bold" Margin="0,10,0,0"/>
                                <WrapPanel>
                                    <Button Content="✓" ToolTip="Подтвердить" FontSize="18" Width="50"/>
                                    <Button Content="✎" ToolTip="Редактировать" FontSize="18" Width="50"/>
                                    <Button Content="↻" ToolTip="Обновить" FontSize="18" Width="50"/>
                                    <Button Content="✕" ToolTip="Закрыть" FontSize="18" Width="50"/>
                                </WrapPanel>
                                <TextBlock Text="Переключатели" FontWeight="Bold" Margin="0,10,0,0"/>
                                <WrapPanel>
                                    <CheckBox Content="Включено" IsChecked="True" Margin="8"/>
                                    <CheckBox Content="Отключено" Margin="8"/>
                                    <RadioButton Content="Вариант A" IsChecked="True" Margin="8"/>
                                    <RadioButton Content="Вариант B" Margin="8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="1.3.2 ListBox, ComboBox, TextBox, PasswordBox, RichTextBox" IsExpanded="True">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ListBox" FontWeight="Bold"/>
                                    <ListBox Height="100" SelectedIndex="0">
                                        <ListBoxItem>Элемент 1</ListBoxItem><ListBoxItem>Элемент 2</ListBoxItem><ListBoxItem>Элемент 3</ListBoxItem>
                                    </ListBox>
                                    <TextBlock Text="ComboBox" FontWeight="Bold" Margin="0,10,0,0"/>
                                    <ComboBox SelectedIndex="0"><ComboBoxItem>Первый</ComboBoxItem><ComboBoxItem>Второй</ComboBoxItem><ComboBoxItem>Третий</ComboBoxItem></ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0">
                                    <TextBlock Text="TextBox" FontWeight="Bold"/>
                                    <TextBox Text="Редактируемый текст"/>
                                    <TextBlock Text="PasswordBox" FontWeight="Bold" Margin="0,10,0,0"/>
                                    <PasswordBox Password="password"/>
                                    <TextBlock Text="TextBox (Multiline)" FontWeight="Bold" Margin="0,10,0,0"/>
                                    <TextBox Height="80" TextWrapping="Wrap" AcceptsReturn="True" Text="Многострочный текст..."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="10,0">
                                    <TextBlock Text="RichTextBox" FontWeight="Bold"/>
                                    <RichTextBox Height="150"><FlowDocument><Paragraph>Форматированный текст <Bold>WPF</Bold>.</Paragraph><Paragraph Foreground="{DynamicResource AccentBrush}">Акцентная строка.</Paragraph></FlowDocument></RichTextBox>
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <Expander Header="1.3.3 TextBlock, Label — заголовки 1–3, обычный текст и подпись" IsExpanded="True">
                            <StackPanel Margin="8">
                                <TextBlock Text="Заголовок 1" FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="Заголовок 2" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Заголовок 3" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Обычный текст TextBlock — описание элемента интерфейса." Margin="0,6"/>
                                <Label Content="Подпись Label — дополнительное пояснение."/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="1.3.4 TreeView" IsExpanded="True">
                            <TreeView Height="150" Margin="8">
                                <TreeViewItem Header="Приложение" IsExpanded="True">
                                    <TreeViewItem Header="Настройки"><TreeViewItem Header="Тема"/><TreeViewItem Header="Язык"/><TreeViewItem Header="Шрифт"/></TreeViewItem>
                                    <TreeViewItem Header="Данные"/>
                                </TreeViewItem>
                            </TreeView>
                        </Expander>

                        <Expander Header="1.3.5 DataGrid — пример привязки к данным" IsExpanded="True">
                            <DataGrid Height="180" Margin="8" ItemsSource="{Binding SourceRows}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Тип" Binding="{Binding Category}" Width="150"/>
                                    <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>

                        <Expander Header="1.3.6 ProgressBar" IsExpanded="True">
                            <StackPanel Margin="8">
                                <ProgressBar Height="24" Minimum="0" Maximum="100" Value="25" Margin="0,3"/>
                                <ProgressBar Height="24" Minimum="0" Maximum="100" Value="65" Margin="0,3"/>
                                <ProgressBar Height="24" Minimum="0" Maximum="100" Value="100" Margin="0,3"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="1.3.7 Всплывающие подсказки" IsExpanded="True">
                            <WrapPanel Margin="8">
                                <Button Content="Наведи на меня" ToolTip="Это всплывающая подсказка"/>
                                <TextBlock Text=" ℹ Наведение на элементы показывает ToolTip." VerticalAlignment="Center"/>
                            </WrapPanel>
                        </Expander>

                        <Expander Header="1.3.8 Меню и контекстное меню" IsExpanded="True">
                            <StackPanel Margin="8">
                                <TextBlock Text="Верхнее Menu находится в шапке окна. Ниже — локальное контекстное меню."/>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushLab}" BorderThickness="1" Padding="12" Margin="0,8,0,0">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Копировать"/><MenuItem Header="Вставить"/><Separator/><MenuItem Header="Удалить"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <TextBlock Text="Клик правой кнопкой мыши по этому блоку."/>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Контейнеры ЛР1 -->
            <TabItem Header="1.4 Контейнеры">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Контейнеры компонентов" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="Сравнение способов компоновки на примере цветных прямоугольников." Margin="0,0,0,15"/>

                        <GroupBox Header="Grid — табличное размещение">
                            <Grid Height="150">
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Margin="4" Background="{DynamicResource AccentBrush}" CornerRadius="6"><TextBlock Text="Grid 1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Grid.Column="1" Margin="4" Background="{DynamicResource SuccessBrush}" CornerRadius="6"><TextBlock Text="Grid 2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Grid.Column="2" Margin="4" Background="{DynamicResource InfoBrush}" CornerRadius="6"><TextBlock Text="Grid 3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="4" Background="{DynamicResource MainBrush}" BorderBrush="{DynamicResource BorderBrushLab}" BorderThickness="1"><TextBlock Text="Grid RowSpan / ColumnSpan" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="StackPanel — последовательное размещение">
                            <StackPanel Orientation="Horizontal" Height="90">
                                <Border Width="150" Margin="4" Background="{DynamicResource SuccessBrush}"><TextBlock Text="Horizontal 1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Width="150" Margin="4" Background="{DynamicResource AccentBrush}"><TextBlock Text="Horizontal 2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Width="150" Margin="4" Background="{DynamicResource ErrorBrush}"><TextBlock Text="Horizontal 3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="WrapPanel — перенос элементов">
                            <WrapPanel>
                                <Border Width="170" Height="65" Margin="4" Background="{DynamicResource InfoBrush}"><TextBlock Text="Wrap 1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Width="170" Height="65" Margin="4" Background="{DynamicResource AccentBrush}"><TextBlock Text="Wrap 2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Width="170" Height="65" Margin="4" Background="{DynamicResource SuccessBrush}"><TextBlock Text="Wrap 3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Width="170" Height="65" Margin="4" Background="{DynamicResource ErrorBrush}"><TextBlock Text="Wrap 4" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Header="DockPanel — привязка к сторонам">
                            <DockPanel Height="110" LastChildFill="True">
                                <Border DockPanel.Dock="Top" Height="30" Background="{DynamicResource AccentBrush}"><TextBlock Text="Top" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border DockPanel.Dock="Left" Width="140" Background="{DynamicResource SuccessBrush}"><TextBlock Text="Left" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border DockPanel.Dock="Right" Width="140" Background="{DynamicResource ErrorBrush}"><TextBlock Text="Right" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Background="{DynamicResource MainBrush}" BorderBrush="{DynamicResource BorderBrushLab}" BorderThickness="1"><TextBlock Text="Оставшееся пространство" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Canvas — абсолютное позиционирование">
                            <Canvas Height="150" Background="{DynamicResource MainBrush}">
                                <Border Canvas.Left="20" Canvas.Top="20" Width="180" Height="55" Background="{DynamicResource AccentBrush}" CornerRadius="5"><TextBlock Text="Canvas Left=20 Top=20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Canvas.Left="280" Canvas.Top="70" Width="200" Height="55" Background="{DynamicResource InfoBrush}" CornerRadius="5"><TextBlock Text="Canvas Left=280 Top=70" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            </Canvas>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Новая вкладка: редактирование, удаление, копирование между таблицами -->
            <TabItem Header="Работа с таблицами">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="4,0,4,8">
                        <TextBlock Text="Редактирование данных и перенос строк между таблицами" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="Изменяйте ячейки прямо в таблицах. Добавление, удаление, копирование и вставка выполняются командами MVVM." TextWrapping="Wrap" Opacity="0.8"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <GroupBox Header="Таблица 1 — исходные данные" Margin="4">
                            <DockPanel>
                                <ToolBarTray DockPanel.Dock="Top">
                                    <ToolBar>
                                        <Button Content="Добавить строку" Command="{Binding AddSourceRowCommand}"/>
                                        <Button Content="Удалить выбранную" Command="{Binding DeleteSourceRowCommand}" Background="{DynamicResource ErrorBrush}"/>
                                        <Button Content="Копировать →" Command="{Binding CopySourceCommand}"/>
                                    </ToolBar>
                                </ToolBarTray>
                                <DataGrid ItemsSource="{Binding SourceRows}"
                                          SelectedItem="{Binding SelectedSourceRow, Mode=TwoWay}"
                                          CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single"
                                          AutoGenerateColumns="False" AlternationCount="2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="55"/>
                                        <DataGridTextColumn Header="Название" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTextColumn Header="Тип" Binding="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                        <DataGridTextColumn Header="Состояние" Binding="{Binding State, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Header="Таблица 2 — целевые данные" Margin="4">
                            <DockPanel>
                                <ToolBarTray DockPanel.Dock="Top">
                                    <ToolBar>
                                        <Button Content="Добавить строку" Command="{Binding AddDestinationRowCommand}"/>
                                        <Button Content="Удалить выбранную" Command="{Binding DeleteDestinationRowCommand}" Background="{DynamicResource ErrorBrush}"/>
                                        <Button Content="Вставить из буфера" Command="{Binding PasteToDestinationCommand}"/>
                                        <Button Content="Копировать ←" Command="{Binding CopyDestinationCommand}"/>
                                        <Button Content="Вставить в таблицу 1" Command="{Binding PasteToSourceCommand}"/>
                                    </ToolBar>
                                </ToolBarTray>
                                <DataGrid ItemsSource="{Binding DestinationRows}"
                                          SelectedItem="{Binding SelectedDestinationRow, Mode=TwoWay}"
                                          CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single"
                                          AutoGenerateColumns="False" AlternationCount="2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="55"/>
                                        <DataGridTextColumn Header="Название" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTextColumn Header="Тип" Binding="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                        <DataGridTextColumn Header="Состояние" Binding="{Binding State, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>
                    </Grid>

                    <Border Grid.Row="2" Margin="4,8,4,0" Padding="10" Background="{DynamicResource MainBrush}" BorderBrush="{DynamicResource BorderBrushLab}" BorderThickness="1" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="Панель инструментов и буфер копирования" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ClipboardStatus}"/>
                            <TextBlock Text="Сценарий: выберите строку в таблице 1 → «Копировать →» → «Вставить» в таблицу 2. Для обратного направления выберите строку таблицы 2 → «Копировать ←» → «Вставить в таблицу 1»." TextWrapping="Wrap" Opacity="0.8"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Новая вкладка: виды Binding и UpdateSourceTrigger -->
            <TabItem Header="Привязки и режимы обновления">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Демонстрация типов привязки данных WPF" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="На вкладке показаны режимы OneWay, TwoWay, OneWayToSource, OneTime, а также способы обновления источника Default, PropertyChanged, LostFocus и Explicit." TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <GroupBox Header="Режимы привязки (Binding Mode)">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                <StackPanel Margin="6">
                                    <TextBlock Text="Mode=OneWay — источник → интерфейс" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding OneWayText, Mode=OneWay}" Padding="8" Background="{DynamicResource MainBrush}" TextWrapping="Wrap" Margin="0,5"/>
                                    <Button Content="Изменить источник OneWay" Command="{Binding ChangeOneWaySourceCommand}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Изменение свойства ViewModel автоматически отображается в TextBlock. Обратное изменение из TextBlock невозможно." TextWrapping="Wrap" Opacity="0.75"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="6">
                                    <TextBlock Text="Mode=TwoWay — двусторонняя связь" FontWeight="Bold"/>
                                    <TextBox Text="{Binding TwoWayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Значение во ViewModel:" Margin="4,4,4,0" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TwoWayText}" TextWrapping="Wrap" Margin="4"/>
                                    <TextBlock Text="Изменение поля сразу передаётся в источник, а изменение источника отображается в поле." TextWrapping="Wrap" Opacity="0.75"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="6">
                                    <TextBlock Text="Mode=OneWayToSource — интерфейс → источник" FontWeight="Bold"/>
                                    <TextBox Text="{Binding OneWayToSourceInput, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Получено в источнике:" Margin="4,4,4,0" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OneWayToSourceInput}" TextWrapping="Wrap" Margin="4"/>
                                    <TextBlock Text="Текст из поля отправляется в свойство ViewModel. Источник не задаёт начальное содержимое поля." TextWrapping="Wrap" Opacity="0.75"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6">
                                    <TextBlock Text="Mode=OneTime — однократное получение значения" FontWeight="Bold"/>
                                    <Border Background="{DynamicResource MainBrush}" Padding="8" Margin="0,5">
                                        <TextBlock Text="{Binding OneTimeValue, Mode=OneTime}" TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock Text="Текущее значение источника:" Margin="4,4,4,0" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OneTimeValue}" TextWrapping="Wrap" Margin="4"/>
                                    <Button Content="Изменить свойство источника" Command="{Binding ChangeOneTimeValueCommand}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Первый TextBlock остаётся со старым значением; привязка OneTime не обновляет цель после изменения источника." TextWrapping="Wrap" Opacity="0.75"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="UpdateSourceTrigger — когда передавать изменения в источник">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- PropertyChanged -->
                                <GroupBox Header="1. PropertyChanged"
                  Grid.Row="0" Grid.Column="0"
                  Margin="6">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Обновление сразу при вводе"
                           TextWrapping="Wrap"/>
                                        <TextBox Text="{Binding PropertyChangedText,
                    Mode=TwoWay,
                    UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Значение источника:"/>
                                        <TextBlock Text="{Binding PropertyChangedText}"
                           TextWrapping="Wrap"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- LostFocus -->
                                <GroupBox Header="2. LostFocus"
                  Grid.Row="0" Grid.Column="1"
                  Margin="6">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Обновление при потере фокуса"
                           TextWrapping="Wrap"/>
                                        <TextBox Text="{Binding LostFocusText,
                    Mode=TwoWay,
                    UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Text="Значение источника:"/>
                                        <TextBlock Text="{Binding LostFocusText}"
                           TextWrapping="Wrap"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Default -->
                                <GroupBox Header="3. Default"
                  Grid.Row="1" Grid.Column="0"
                  Margin="6">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Стандартное поведение TextBox"
                           TextWrapping="Wrap"/>
                                        <TextBox Text="{Binding DefaultTriggerText,
                    Mode=TwoWay,
                    UpdateSourceTrigger=Default}"/>
                                        <TextBlock Text="Значение источника:"/>
                                        <TextBlock Text="{Binding DefaultTriggerText}"
                           TextWrapping="Wrap"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Explicit -->
                                <GroupBox Header="4. Explicit"
                  Grid.Row="1" Grid.Column="1"
                  Margin="6">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Обновление после подтверждения"
                           TextWrapping="Wrap"/>

                                        <TextBox x:Name="ExplicitBindingTextBox"
                         Text="{Binding ExplicitText,
                         Mode=TwoWay,
                         UpdateSourceTrigger=Explicit}"/>

                                        <Button Content="Подтвердить ввод"
                        Command="{Binding CommitExplicitBindingCommand}"
                        CommandParameter="{Binding ElementName=ExplicitBindingTextBox}"/>

                                        <TextBlock Text="Значение источника:"/>
                                        <TextBlock Text="{Binding ExplicitText}"
                           TextWrapping="Wrap"/>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </GroupBox>

                        <WrapPanel>
                            <Button Content="Сбросить примеры" Command="{Binding ResetBindingDemoCommand}"/>
                            <TextBlock Text="Для Explicit сначала измените текст в поле, затем нажмите кнопку подтверждения." VerticalAlignment="Center" Margin="8" TextWrapping="Wrap"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
